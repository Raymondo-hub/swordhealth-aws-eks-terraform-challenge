aws_region                          = "us-east-1"
project_name                        = "swordhealth"
environment                         = "prod"
vpc_cidr                            = "10.20.0.0/16"
private_subnet_cidrs                = ["10.20.0.0/20", "10.20.16.0/20"]
public_subnet_cidrs                 = ["10.20.40.0/24", "10.20.41.0/24"]
database_subnet_cidrs               = ["10.20.32.0/24", "10.20.33.0/24"]
single_nat_gateway                  = false
kubernetes_version                  = "1.35"
platform_admin_role_arn             = "arn:aws:iam::008003619776:role/aws-reserved/sso.amazonaws.com/AWSReservedSSO_AdministratorAccess_433a585f5aff77e3"
namespace_editor_role_arns          = []
node_instance_types                 = ["m6i.large"]
node_min_size                       = 2
node_desired_size                   = 2
node_max_size                       = 6
database_instance_class             = "db.t4g.micro"
database_multi_az                   = false
database_deletion_protection        = true
database_backup_retention_days      = 35
application_namespace               = "swordhealth"
application_service_account_name    = "node-example"
database_backup_window              = "03:00-05:00"
